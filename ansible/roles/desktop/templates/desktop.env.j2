# Written by Rookery's desktop role. `box exec` and an exec with the desktop's
# environment read it, so that a command runs in this session rather than beside
# it: the same display, the same X authority, and the same session bus.
DISPLAY={{ desktop_display }}
XAUTHORITY={{ desktop_home }}/.Xauthority
DBUS_SESSION_BUS_ADDRESS=unix:path={{ desktop_runtime_dir }}/bus
XDG_RUNTIME_DIR={{ desktop_runtime_dir }}
PATH=/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin
