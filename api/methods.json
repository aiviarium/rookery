  {
    "name": "auth.me",
    "summary": "Who the caller is, and how this server signs people in.",
    "level": {
      "kind": "self"
    },
    "params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Params or a result with nothing in it: `{}`.",
      "title": "Empty",
      "type": "object"
    },
    "result": {
      "$defs": {
        "AuthMode": {
          "oneOf": [
            {
              "const": "local",
              "description": "Local accounts, signed in by one-time links.",
              "type": "string"
            },
            {
              "const": "oidc",
              "description": "An OpenID Connect identity provider.",
              "type": "string"
            }
          ]
        },
        "Principal": {
          "description": "Who acts.",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "$ref": "#/$defs/PrincipalKind"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        "PrincipalKind": {
          "oneOf": [
            {
              "const": "user",
              "description": "A person, by a device session or an access token.",
              "type": "string"
            },
            {
              "const": "local",
              "description": "The server's own machine, over the Unix socket: an admin with no user.",
              "type": "string"
            },
            {
              "const": "system",
              "description": "Code inside the server, such as a job handler.",
              "type": "string"
            },
            {
              "const": "plugin",
              "description": "A plugin, acting for itself.",
              "type": "string"
            }
          ]
        },
        "User": {
          "description": "A person known to the server.",
          "properties": {
            "admin": {
              "type": "boolean"
            },
            "email": {
              "type": [
                "string",
                "null"
              ]
            },
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "name",
            "admin"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`auth.me`.",
      "properties": {
        "admin": {
          "description": "Whether the caller has the org role admin.",
          "type": "boolean"
        },
        "apiVersion": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "auth": {
          "$ref": "#/$defs/AuthMode",
          "description": "How people sign in to this server: `local` or `oidc`."
        },
        "principal": {
          "$ref": "#/$defs/Principal"
        },
        "user": {
          "anyOf": [
            {
              "$ref": "#/$defs/User"
            },
            {
              "type": "null"
            }
          ],
          "description": "The person; none over the Unix socket."
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "principal",
        "admin",
        "auth",
        "version",
        "apiVersion"
      ],
      "title": "Me",
      "type": "object"
    }
  },
