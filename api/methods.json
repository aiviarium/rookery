  {
    "name": "streams.close",
    "summary": "Ends a stream in both directions.",
    "level": {
      "kind": "self"
    },
    "params": {
      "$defs": {
        "ErrorBody": {
          "description": "An error inside another message: a stream closed with an error, a failed job.",
          "properties": {
            "code": {
              "$ref": "#/$defs/ErrorCode"
            },
            "details": true,
            "message": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "type": "object"
        },
        "ErrorCode": {
          "oneOf": [
            {
              "const": "INVALID",
              "description": "The params fail the schema, or the request is wrong.",
              "type": "string"
            },
            {
              "const": "FORBIDDEN",
              "description": "The caller lacks the level on the resource.",
              "type": "string"
            },
            {
              "const": "NOT_FOUND",
              "description": "No such method, row or thing.",
              "type": "string"
            },
            {
              "const": "CONFLICT",
              "description": "A revision or compare-and-swap did not match, or a lease is held.",
              "type": "string"
            },
            {
              "const": "UNAVAILABLE",
              "description": "Something it needs is not there: a key, a host, or this server is a standby.",
              "type": "string"
            },
            {
              "const": "TIMEOUT",
              "description": "The call's deadline passed.",
              "type": "string"
            },
            {
              "const": "INTERNAL",
              "description": "A bug.",
              "type": "string"
            },
            {
              "const": "UNAUTHENTICATED",
              "description": "The request has no session or token that works: sign in again.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`streams.close`: ends both directions. An error says why.",
      "properties": {
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorBody"
            },
            {
              "type": "null"
            }
          ]
        },
        "stream": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "stream"
      ],
      "title": "StreamClose",
      "type": "object"
    },
    "result": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Params or a result with nothing in it: `{}`.",
      "title": "Empty",
      "type": "object"
    }
  },
