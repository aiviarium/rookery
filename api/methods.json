[
  {
    "name": "auth.createLink",
    "summary": "Makes a one-time sign-in link: a device link for oneself, an invite or a device link for another as admin, the first admin's setup link on the server's own machine.",
    "level": {
      "kind": "self"
    },
    "params": {
      "$defs": {
        "LinkKind": {
          "oneOf": [
            {
              "const": "setup",
              "description": "Makes a new admin: the first one, from `rookery server setup-key`.",
              "type": "string"
            },
            {
              "const": "invite",
              "description": "Makes a new user with the name an admin gave.",
              "type": "string"
            },
            {
              "const": "device",
              "description": "Signs an existing user in on another device.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "`auth.createLink`.",
      "properties": {
        "email": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/LinkKind"
        },
        "name": {
          "default": null,
          "description": "The name of the person an invite makes.",
          "type": [
            "string",
            "null"
          ]
        },
        "userId": {
          "default": null,
          "description": "For a device link: whose. The caller's own without one.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "title": "LinkCreate",
      "type": "object"
    },
    "result": {
      "$defs": {
        "LinkInfo": {
          "description": "A link that has not been used.",
          "properties": {
            "createdAt": {
              "type": "string"
            },
            "createdByName": {
              "type": [
                "string",
                "null"
              ]
            },
            "expiresAt": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "kind": {
              "$ref": "#/$defs/LinkKind"
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "userName": {
              "description": "For a device link, the person it signs in.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "kind",
            "createdAt",
            "expiresAt"
          ],
          "type": "object"
        },
        "LinkKind": {
          "oneOf": [
            {
              "const": "setup",
              "description": "Makes a new admin: the first one, from `rookery server setup-key`.",
              "type": "string"
            },
            {
              "const": "invite",
              "description": "Makes a new user with the name an admin gave.",
              "type": "string"
            },
            {
              "const": "device",
              "description": "Signs an existing user in on another device.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The result of `auth.createLink`: the link, shown this once.",
      "properties": {
        "info": {
          "$ref": "#/$defs/LinkInfo"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "url",
        "info"
      ],
      "title": "LinkCreated",
      "type": "object"
    }
  },
  {
    "name": "auth.createToken",
