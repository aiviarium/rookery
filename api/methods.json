          "type": [
            "integer",
            "null"
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "TokenCreate",
      "type": "object"
    },
    "result": {
      "$defs": {
        "TokenInfo": {
          "description": "An access token, without the token.",
          "properties": {
            "createdAt": {
              "type": "string"
            },
            "expiresAt": {
              "type": [
                "string",
                "null"
              ]
            },
            "hint": {
              "description": "The last characters of the token, to tell tokens apart.",
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "lastUsedAt": {
              "type": [
                "string",
                "null"
              ]
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "name",
            "hint",
            "createdAt"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The result of `auth.createToken`: the token, shown this once.",
      "properties": {
        "info": {
          "$ref": "#/$defs/TokenInfo"
        },
        "token": {
          "description": "`rookery_pat_…`.",
          "type": "string"
        }
      },
      "required": [
        "token",
        "info"
      ],
      "title": "TokenCreated",
      "type": "object"
    }
  },
