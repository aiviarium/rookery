      "kind": "self"
    },
    "params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "`auth.createToken`.",
      "properties": {
        "expiresInDays": {
          "default": null,
          "description": "Days until it expires, 1 to 3650; it lasts until revoked without one.",
