{
  "name": "rookery",
  "private": true,
  "type": "module",
  "workspaces": [
    "sdk",
    "client",
    "host"
  ],
  "scripts": {
    "lint": "biome ci client sdk host",
    "format": "biome format --write client sdk host",
    "typecheck": "tsc -p sdk/tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit && tsc -p host/tsconfig.json --noEmit",
    "test": "bun test sdk/test client/test host/test",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-typescript": "^7.29.7",
    "@biomejs/biome": "^2.4.12",
    "@happy-dom/global-registrator": "^20.14.6",
    "@types/bun": "^1.3.14",
    "babel-preset-solid": "^1.9.19",
    "solid-js": "^1.9.19",
    "typescript": "^5.9.3"
  }
}
