format 1

package {
  group rookery
  id unity
  version "0.1.0"
}

about {
  name "Unity"
  summary "Unity CLI and editor for rookery machines."
  license MIT
  license Apache-2.0
  repository "https://github.com/aiviarium/rookery"
  keywords rookery-plugin
}

targets {
  rookery {
    requires {
      rookery ">=0.6"
    }
  }
}
