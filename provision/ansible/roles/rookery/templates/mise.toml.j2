# Managed by rookery. Project-local mise.toml files may select other versions.
[tools]
node = {{ rookery_node_versions | to_json }}
{% for category in rookery_tool_categories %}
{% if category.enabled | bool %}
{% for name in category.tools %}
{{ name | to_json }} = {{ rookery_mise_tools[name] | to_json }}
{% endfor %}
{% endif %}
{% endfor %}
