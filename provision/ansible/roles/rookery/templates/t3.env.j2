T3CODE_HOST={{ rookery_bind }}
T3CODE_PORT=3773
DISPLAY=:1
XAUTHORITY={{ rookery_home }}/.config/rookery.Xauthority
XDG_RUNTIME_DIR=/run/user/{{ rookery_uid }}
DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{{ rookery_uid }}/bus
DISABLE_AUTOUPDATER=1
PATH={{ rookery_tool_path }}
ROOKERY_SOFTWARE_RENDERING={{ '1' if rookery_software_rendering else '0' }}
{% if rookery_software_rendering %}
LIBGL_ALWAYS_SOFTWARE=1
GALLIUM_DRIVER=llvmpipe
__GLX_VENDOR_LIBRARY_NAME=mesa
VK_DRIVER_FILES={{ rookery_lvp_icd }}
{% endif %}
