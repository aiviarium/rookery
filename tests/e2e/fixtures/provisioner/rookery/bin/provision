#!/usr/bin/env python3
"""The end-to-end tests' provisioner, which rookery runs where it runs itself.

Version 2 of rookery's provisioner protocol: one JSON request on stdin, one
JSON answer on stdout, progress on stderr. Nothing here starts a machine: the
stack has no provider behind it, so a machine is a record and the seed rookery
rendered is not handed anywhere. The record has no address, which is what a
seeded machine that sets itself up on its own looks like.
"""
import json
import sys
import time

PROTOCOL = 2
VERBS = ('create', 'status', 'list', 'start', 'stop', 'destroy', 'logs')


class Failure(Exception):
    pass


def say(text):
    print(text, file=sys.stderr, flush=True)


def create(request):
    host = request['host']
    name = request['name']
    say(f'Pretending to make {name} for {host}.')
    # The job's log is followed while it runs, so the lines come apart.
    time.sleep(0.6)
    say(f'Giving {name} {request["arguments"].get("cpus", "2")} CPUs and '
        f'{request["arguments"].get("memory", "2GiB")} of memory.')
    time.sleep(0.6)
    say(f'Recording {name}; this stack has no provider to start it on.')
    time.sleep(0.6)
    return {'id': f'fleetbox-{name}'}


def status(request):
    if not request.get('id'):
        return {'state': 'ready', 'message': 'records machines, and starts none'}
    return {'state': 'running'}


def list_(request):
    return {'resources': []}


def logs(request):
    print(f'{request.get("name", request.get("id", "machine"))}: nothing to show')
    return None


def changed(request):
    return {}


def main():
    try:
        verb = sys.argv[1] if len(sys.argv) > 1 else ''
        if verb not in VERBS:
            raise Failure(f'unknown verb {verb!r}')
        request = json.load(sys.stdin)
        if request.get('version') != PROTOCOL:
            raise Failure(f'this plugin speaks version {PROTOCOL} of the provisioner protocol, '
                          f'not {request.get("version")!r}')
        handler = {
            'create': create,
            'status': status,
            'list': list_,
            'start': changed,
            'stop': changed,
            'destroy': changed,
            'logs': logs,
        }[verb]
        answer = handler(request)
    except Failure as error:
        say(f'example/fleetbox: {error}')
        return 1
    except (json.JSONDecodeError, KeyError) as error:
        say(f'example/fleetbox: bad request: {error}')
        return 1
    if answer is not None:
        print(json.dumps(answer))
    return 0


if __name__ == '__main__':
    sys.exit(main())
